root ::= ws (sql-object | clarification-object) ws

sql-object ::= "{" ws "\"sql\"" ws ":" ws sql-string ws "}"
clarification-object ::= "{" ws "\"clarification\"" ws ":" ws json-string ws "}"

sql-string ::= "\"" ("SELECT " sql-char* | "WITH " sql-char*) "\""
json-string ::= "\"" json-char* "\""

sql-char ::= [^"\\\x00-\x1f] | escape
json-char ::= [^"\\\x00-\x1f] | escape
escape ::= "\\" (["\\/bfnrt] | "u" hex hex hex hex)
hex ::= [0-9a-fA-F]
ws ::= [ \t\n\r]*
